{
  "name": "gitnest",
  "version": "1.0.0",
  "description": "GitNest：GitHub REST API + 本地 Git 的桌面仓库管理工具",
  "main": "electron/main.js",
  "author": {
    "name": "Uaison"
  },
  "license": "Apache-2.0",
  "copyright": "Copyright (c) 2026 Uaison",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "build:obf": "cross-env OBFUSCATE=1 vite build",
    "build:legal": "node scripts/build-legal-site.js",
    "build:win": "npm run build:obf && electron-builder --win --publish never",
    "build:portable": "npm run build:obf && electron-builder --win portable --publish never",
    "build:msix": "npm run build:obf && electron-builder --win appx --publish never",
    "cert:dev": "powershell -ExecutionPolicy Bypass -File scripts/make-dev-cert.ps1",
    "build:msix:sideload": "npm run build:obf && electron-builder --win appx --config electron-builder.sideload.js --publish never",
    "sign:release": "powershell -ExecutionPolicy Bypass -File scripts/sign-release.ps1",
    "preview": "vite preview"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "electron-store": "^8.1.0",
    "highlight.js": "^11.12.0",
    "marked": "^4.3.0",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^26.18.1",
    "javascript-obfuscator": "^4.1.1",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "io.gitnest.app",
    "productName": "GitNest",
    "copyright": "Copyright (c) 2026 Uaison",
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.js",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "LICENSE",
      "NOTICE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "license": "LICENSE",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "appx": {
      "applicationId": "GitNest",
      "identityName": "uaison.GitNest",
      "publisher": "CN=8D2E8A55-A948-4001-94F4-D7FC476668EF",
      "publisherDisplayName": "uaison",
      "displayName": "GitNest",
      "artifactName": "${productName} ${version}.msix",
      "capabilities": [
        "internetClient"
      ],
      "languages": [
        "zh-CN",
        "en-US"
      ],
      "backgroundColor": "#1f2328",
      "showNameOnTiles": true,
      "minVersion": "10.0.17763.0"
    }
  }
}
